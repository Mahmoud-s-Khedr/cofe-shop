# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:800
LOG_LEVEL=log
LOG_PRETTY=true
LOG_HTTP_BODY=true

# ── Docker / Ingress (compose contract) ──────────────────────────────────────
NGINX_LISTEN_PORT=80
NGINX_HOST_PORT=800
NGINX_BIND_IP=127.0.0.1

# ── Database (internal postgres container in docker-compose.dev.yml) ─────────
POSTGRES_DB=bw_cafe_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/bw_cafe_db
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Admin seed / OTP ──────────────────────────────────────────────────────────
ADMIN_PHONE=+22200000000
ADMIN_PASSWORD=ChangeMe123
OTP_TTL_MINUTES=10
# No SMS provider is wired up yet — codes are returned in API responses.
OTP_DEV_MODE=true
OTP_SIGNING_SECRET=change_this_otp_signing_secret

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_DEV_BYPASS=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
