# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://yourdomain.com
LOG_LEVEL=log
LOG_PRETTY=false
LOG_HTTP_BODY=false

# ── Docker / Ingress (compose contract) ──────────────────────────────────────
NGINX_LISTEN_PORT=80
NGINX_HOST_PORT=800
NGINX_BIND_IP=127.0.0.1

# ── Database (external managed postgres) ─────────────────────────────────────
DATABASE_URL=postgres://postgres:password@db-host:5432/bw_cafe_db
DATABASE_SSL=true
DATABASE_POOL_MAX=20

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Admin seed / OTP ──────────────────────────────────────────────────────────
ADMIN_PHONE=+22200000000
ADMIN_PASSWORD=ChangeMe123
OTP_TTL_MINUTES=10
# Set to false once a real SMS provider is wired up.
OTP_DEV_MODE=false
OTP_SIGNING_SECRET=change_this_otp_signing_secret

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_DEV_BYPASS=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Infra/Tooling: Compose Postgres (used by docker-compose.dev.yml) ────────
POSTGRES_DB=bw_cafe_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
